# Environment Variables & API Key Configuration
# Copy this file to .env and insert your real OpenRouter API key

# OpenRouter API Key
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-flash-1.5

# Framework & Operational Parameters
GRID_EMISSION_FACTOR=0.716
LOG_LEVEL=INFO
KNOWLEDGE_BASE_DIR=knowledge_base
PROMPTS_DIR=prompts
